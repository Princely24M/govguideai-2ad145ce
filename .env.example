# Copy to .env and fill in your own values. Never commit the real .env file.

# Supabase — client-safe publishable values
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Supabase — server-side (same public values, used during SSR)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=

# AI Gateway key — server-side secret, set in the hosting environment, never commit
LOVABLE_API_KEY=
